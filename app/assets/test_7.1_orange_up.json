[
  {
    "name": "Test_7.1_Initialization",
    "label": "Start Test 7.1 (Orange Up)",
    "colour": "#2196F3",
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar test_started t)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar test_completed nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar current_face \"orange\")\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count 0)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar or_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar og_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar ow_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar om_complete nil)\n"},
      
      {"type": "SendStringOverNUS", "value": "(toggle 'wcgx)\n"},
      {"type": "SendStringOverNUS", "value": "(toggle 'wcgy)\n"},
      {"type": "SendStringOverNUS", "value": "(toggle 'wcgz)\n"},
      {"type": "SendStringOverNUS", "value": "(toggle 'wacx)\n"},
      {"type": "SendStringOverNUS", "value": "(toggle 'wacy)\n"},
      {"type": "SendStringOverNUS", "value": "(toggle 'wacz)\n"},
      {"type": "SendStringOverNUS", "value": "(emo dbsm 0)\n"},
      {"type": "SendStringOverNUS", "value": "(ecr dbsm)\n"},
      
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Hold the device with Orange side up. Test tapping on Red, Green, White, and Magenta sides.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Instruction_Display",
    "label": "{{instruction_text}}",
    "colour": "#8E24AA",
    "condition": {
      "operator": "EQUALS",
      "left": "{{test_started}}",
      "right": "t"
    }
  },
  {
    "name": "Orange_Up",
    "label": "Detecting Orange Up Position",
    "colour": "#FFA000",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "GT", "left": "{{wcgz}}", "right": 0.9 },
        { "operator": "GT", "left": "{{test_started}}", "right": "nil" }
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(princ \"(orange_up_detected)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Orange side detected! Now tap on the Red, Green, White, and Magenta sides one by one.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Or",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "GT", "left": "{{wcgz}}", "right": 0.9 },
        { "operator": "OR", "expressions": [
          { "operator": "GT", "left": "{{wacy}}", "right": 7.0 },
          { "operator": "LT", "left": "{{wacz}}", "right": -25.0 }
        ]}
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar or_complete t)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count (+ pass_count 1))\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(or_test_passed)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Tap on Red side detected! \")(princ pass_count)(princ \"/4 completed.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Og",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "GT", "left": "{{wcgz}}", "right": 0.9 },
        { "operator": "OR", "expressions": [
          { "operator": "LT", "left": "{{wacy}}", "right": 4.0 },
          { "operator": "GT", "left": "{{wacz}}", "right": -20.0 }
        ]}
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar og_complete t)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count (+ pass_count 1))\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(og_test_passed)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Tap on Green side detected! \")(princ pass_count)(princ \"/4 completed.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Ow",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "GT", "left": "{{wcgz}}", "right": 0.9 },
        { "operator": "OR", "expressions": [
          { "operator": "LT", "left": "{{wacx}}", "right": 1.0 },
          { "operator": "GT", "left": "{{wacz}}", "right": -20.0 }
        ]}
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar ow_complete t)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count (+ pass_count 1))\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(ow_test_passed)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Tap on White side detected! \")(princ pass_count)(princ \"/4 completed.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Om",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "GT", "left": "{{wcgz}}", "right": 0.9 },
        { "operator": "OR", "expressions": [
          { "operator": "GT", "left": "{{wacx}}", "right": 2.5 },
          { "operator": "LT", "left": "{{wacz}}", "right": -25.0 }
        ]}
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar om_complete t)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count (+ pass_count 1))\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(om_test_passed)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Tap on Magenta side detected! \")(princ pass_count)(princ \"/4 completed.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Orange_Tests_Complete",
    "condition": {
      "operator": "AND",
      "expressions": [
        { "operator": "EQUALS", "left": "{{or_complete}}", "right": "t" },
        { "operator": "EQUALS", "left": "{{og_complete}}", "right": "t" },
        { "operator": "EQUALS", "left": "{{ow_complete}}", "right": "t" },
        { "operator": "EQUALS", "left": "{{om_complete}}", "right": "t" }
      ]
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar test_completed t)\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(orange_tests_completed)\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Orange side tests complete! All tests passed.\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Move_To_Next_Side",
    "label": "Complete Orange Tests",
    "colour": "#2196F3",
    "condition": {
      "operator": "EQUALS",
      "left": "{{current_face}}",
      "right": "orange"
    },
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar test_completed t)\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(test_summary \\\"Orange face tests completed: \")(princ pass_count)(princ \"/4 tests passed.\\\")\\n\")\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Orange side tests complete. Tests completed: \")(princ pass_count)(princ \"/4\\\")\\n\")\n"}
    ]
  },
  {
    "name": "Test_Summary",
    "label": "{{test_summary}}",
    "colour": "#8E24AA",
    "condition": {
      "operator": "EQUALS",
      "left": "{{test_completed}}",
      "right": "t"
    }
  },
  {
    "name": "Reset_Test",
    "label": "Reset Test",
    "colour": "#F44336",
    "actions": [
      {"type": "SendStringOverNUS", "value": "(defvar test_started nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar test_completed nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar current_face \"orange\")\n"},
      {"type": "SendStringOverNUS", "value": "(defvar pass_count 0)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar or_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar og_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar ow_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(defvar om_complete nil)\n"},
      {"type": "SendStringOverNUS", "value": "(princ \"(instruction_text \\\"Test has been reset. Press Start Test to begin.\\\")\\n\")\n"}
    ]
  }
]
