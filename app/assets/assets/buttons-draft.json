  {
    "name": "def create-averaged-points",
    "label": "def create-averaged-points",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun create-averaged-points ()\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((result '()))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (dolist (entry *fib-acc-data*)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (let ((count (car entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "            (xsum (cadr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "            (ysum (caddr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "            (zsum (cadddr entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (when (> count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "          (push (list (/ xsum count)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "                      (/ ysum count)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "                      (/ zsum count))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "                result))))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (reverse result)))\n"
      }
    ]
  }
