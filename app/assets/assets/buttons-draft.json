  {
    "name": "def sample-acc",
    "label": "def multi-sample-acc",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun multi-sample-acc (n)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (dotimes (i n)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (sample-acc)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    ;; lightweight dummy loop to reduce tight spinning\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (dotimes (j 100) nil))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  'done)\n"
      }
    ]
  },
  {
    "name": "def fib-coverage",
    "label": "def fib-coverage",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun fib-coverage ()\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((filled 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (total 0))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (dolist (entry *fib-acc-data*)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (let ((count (car entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (when (> count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "          (setq filled (+ filled 1)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (setq total (+ total 1))))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (list filled total (/ filled total))))\n"
      }
    ]
  },
