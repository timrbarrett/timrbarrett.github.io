  {
    "name": "def map-mag v2",
    "label": "def map-mag v2",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun map-mag (pt)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((old (cadr (eou dmcx 0)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (new 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (count 10)) ; max 10 tries\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (apply-mapping dmax (car pt))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (apply-mapping dmay (cadr pt))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (apply-mapping dmaz (caddr pt))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (loop\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (setq new (cadr (eou dmcx 0)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (if (or (/= old new) (= count 0)) (return nil))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (setq count (- count 1)))))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (list (cadr (eou dmcx 0))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (cadr (eou dmcy 0))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (cadr (eou dmcz 0))))\n"
      }
    ]
  },
