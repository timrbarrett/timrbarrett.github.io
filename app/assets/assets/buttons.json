  {
    "name": "def update-average-entry",
    "label": "def update-average-entry",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun update-average-entry (avg-entry new-values)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (car avg-entry) (car new-values))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (cadr avg-entry) (cadr new-values))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (caddr avg-entry) (caddr new-values)))\n"
      }
    ]
  },
