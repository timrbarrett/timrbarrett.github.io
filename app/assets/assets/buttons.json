  {
    "name": "def average-from-entry v2",
    "label": "def average-from-entry v2",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun average-from-entry (entry)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((count (car entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (x (cadr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (y (caddr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (z (cadddr entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (if (= count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        '(0 0 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (list (/ x count) (/ y count) (/ z count)))))\n"
      }
    ]
  },
  {
    "name": "def compute-averages",
    "label": "def compute-averages",
    "actions": [
