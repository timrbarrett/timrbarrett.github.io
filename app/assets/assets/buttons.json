  {
    "name": "def sample-acc",
    "label": "def multi-sample",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun multi-sample-acc (n)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (dotimes (i n)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (store-acc-and-mag)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    ;; lightweight dummy loop to reduce tight spinning\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (dotimes (j 100) nil))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  'done)\n"
      }
    ]
  },
  {
    "name": "use multi",
    "label": "use multi",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(multi-sample-acc 50) \n"
      }
    ]
  },
  {
    "name": "def fib-coverage",
    "label": "def fib-coverage",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun fib-coverage ()\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((filled 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (total 0))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (dolist (entry *fib-acc-data*)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": " (let ((count (car entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": " (when (> count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setq filled (+ filled 1)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setq total (+ total 1))))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": " (list filled total (/ filled total))))\n"
      }
    ]
  },
  {
    "name": "fib-coverage",
    "label": "fib-coverage",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(fib-coverage)\n"
      }
    ]
  },
  {
    "name": "def cadddr",
    "label": "def cadddr",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun cadddr (x) (car (cdr (cdr (cdr x)))))\n"
      }
    ]
  },
  {
    "name": "def average-entry v2",
    "label": "def average-entry v2",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun average-entry (entry)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((count (car entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (x (cadr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (y (caddr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (z (cadddr entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (if (> count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (list (/ x count) (/ y count) (/ z count))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        '(0.0 0.0 0.0))))\n"
      }
    ]
  },
  {
    "name": "def set-avg-if-needed",
    "label": "def set-avg-if-needed",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun set-avg-if-needed (entry dest-cell)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((avg (average-entry entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (when avg\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "      (setf (car dest-cell) avg))))\n"
      }
    ]
  },
  {
    "name": "def update-avg-cell",
