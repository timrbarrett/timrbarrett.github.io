  {
    "name": "def update-average-entry",
    "label": "def update-average-entry",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun update-average-entry (avg-entry new-values)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (car avg-entry) (car new-values))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (cadr avg-entry) (cadr new-values))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (setf (caddr avg-entry) (caddr new-values)))\n"
      }
    ]
  },
  {
    "name": "def zip-and-update v4",
    "label": "def zip-and-update v4",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun zip-and-update (src dst)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": " (defvar dst (compute-averages src) ) ) \n"
      }
    ]
  },
  {
    "name": "def average-from-entry v2",
    "label": "def average-from-entry v2",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun average-from-entry (entry)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((count (car entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (x (cadr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (y (caddr entry))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (z (cadddr entry)))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (if (= count 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        '(0 0 0)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "        (list (/ x count) (/ y count) (/ z count)))))\n"
      }
    ]
  },
  {
    "name": "def compute-averages",
    "label": "def compute-averages",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun compute-averages (entries)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (mapcar average-from-entry entries))\n"
      }
    ]
  },
{
  "name": "use compute-averages",
  "label": "use compute-averages",
  "actions": [
    {
      "type": "SendStringOverNUS",
      "value": "(defvar *fib-acc-avg* (compute-averages *fib-acc-data*))\n"
    }
  ]
