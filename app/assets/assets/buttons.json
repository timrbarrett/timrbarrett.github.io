  {
    "name": "def load-mapped-helper",
    "label": "def load-mapped-helper",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun load-mapped-helper (vals names)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (cond\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    ((or (null vals) (null names)) nil)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (t\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "     (apply-mapping (car names) (car vals))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "     (load-mapped-helper (cdr vals) (cdr names)))))\n"
      }
    ]
  },
