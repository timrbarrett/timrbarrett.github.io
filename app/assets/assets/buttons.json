  {
    "name": "def apply-mapping",
    "label": "def apply-mapping",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun apply-mapping (name value)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (progn\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (emo name value)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (ecr name)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (princ \"Result: \") (princ value) (princ \" offered \") (princ (cadr (eou name 0))) (princ \" returned \") (terpri)))\n"
      }
    ]
  },
  {
    "name": "def load-mapped-helper",
    "label": "def load-mapped-helper",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun load-mapped-helper (vals names)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (cond\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    ((or (null vals) (null names)) nil)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "    (t\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "     (apply-mapping (car names) (car vals))\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "     (load-mapped-helper (cdr vals) (cdr names)))))\n"
      }
    ]
  },
  {
    "name": "def load-mapped-values",
    "label": "def load-mapped-values",
    "actions": [
      {
        "type": "SendStringOverNUS",
        "value": "(defun load-mapped-values (data mapping)\n"
      },
      {
        "type": "SendStringOverNUS",
        "value": "  (let ((values data)\n"
