        "type": "SendStringOverNUS",
        "value": "(defvar *etl-type-values* (list 0.46219187 -0.32087585 0.06892925 2.233171 -0.421197 0.038594 0.457376 1.874941 -0.615189 0.049443 0.746624 2.0873))\n"
      },
      {
