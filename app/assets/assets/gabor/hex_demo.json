{
  "defaults": {
    "size_px": 160,
    "sigma_px": 40,
    "contrast": 0.6,
    "orientation_deg": 0,
    "phase_deg": 0,
    "cycles_per_px": 0.02,
    "color": "#000000",
    "background": "#FFFFFF",
    "window": "gaussian"
  },
  "layout": {
    "pattern": "hex",
    "rings": 2,
    "separation_px": 8,
    "grid_rotation_deg": 0
  },
  "patches": [
    { "id": "center", "orientation_deg": 0 },
    { "id": "p1", "orientation_deg": 30 },
    { "id": "p2", "orientation_deg": 60 },
    { "id": "p3", "orientation_deg": 90 },
    { "id": "p4", "orientation_deg": 120 },
    { "id": "p5", "orientation_deg": 150 },
    { "id": "p6", "orientation_deg": 180 }
