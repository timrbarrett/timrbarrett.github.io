{
  "defaults": {
    "size_px": 80,
    "sigma_px": 20,
    "contrast": 0.5,
    "orientation_deg": 0,
    "phase_deg": 0,
    "cycles_per_px": 0.02,
    "color": "#000000",
    "background": "#FFFFFF",
    "window": "gaussian",
    "dual_orientation_mode": "none",
    "enforce_circular_when_orthogonal": true
  },
  "layout": {
    "pattern": "hex",
    "rings": 4,
    "separation_px": 8,
    "grid_rotation_deg": 0
  },
  "patches": [],
  "game": {
    "unmatched_color": "#000000",
    "replace_behavior": "merge-remove-second",
    "matchers": [
      { "param": "phase_deg", "tolerance": 20, "unit": "deg", "color": "#43A047", "average": "circular" },
      { "param": "contrast", "tolerance": 0.05, "unit": "unitless", "color": "#6A1B9A", "average": "arithmetic" },
      { "param": "orientation_deg", "tolerance": 15, "unit": "deg", "color": "#1E88E5", "average": "circular" },
      { "param": "spatial_freq_cpd", "tolerance": 0.2, "unit": "cpd", "color": "#E53935", "average": "arithmetic" }
    ]
  },
  "randomize": {
    "seed": 1337,
    "params": [
      { "param": "dual_orientation_mode", "values": ["grating_vs_window", "principal_axes"] },
      { "param": "orientation_deg", "min": 0, "max": 180 },
      { "param": "phase_deg", "values": ["0", "90", "180", "270"] },
      { "param": "contrast", "min": 0.15, "max": 0.7 },
      { "param": "spatial_freq_cpd", "values": ["1", "2", "4"] },
      { "param": "sigma_px", "min": 14, "max": 26 },
      { "param": "window_orientation_deg", "min": 0, "max": 180 },
      { "param": "sigma_x_px", "min": 14, "max": 28 },
      { "param": "sigma_y_px", "min": 14, "max": 28 },
      { "param": "axes1_angle_deg", "min": 0, "max": 180 },
      { "param": "axes1_sigma_px", "min": 14, "max": 28 },
      { "param": "axes2_angle_deg", "min": 0, "max": 180 },
      { "param": "axes2_sigma_px", "min": 14, "max": 28 }
    ]
  },
  "test": {
    "mode": "afc",
    "staircase": { "type": "1up-2down", "start": 0.4, "step": 0.05, "min": 0.01, "max": 1.0 },
    "trial_order": "fixed",
    "prompt": "Tap the patch you can see best. If none, tap 'None'.",
    "trials": 24,
    "strategy": "interleaved",
    "controls": [
      { "param": "contrast", "start": 0.4, "step": 0.05, "min": 0.01, "max": 1.0, "mode": "add" },
      { "param": "size_px", "start": 160, "step": 8, "min": 64, "max": 256, "mode": "add" }
    ]
  },
  "variants": [
    { "id": "base" },
    { "id": "contrast_down", "contrast": 0.3 },
    { "id": "contrast_up", "contrast": 0.8 },
    { "id": "rotate_45", "orientation_deg": 45 },
    { "id": "higher_sf", "spatial_freq_cpd": 4.0, "pixels_per_degree": 50 },
    { "id": "lower_sf", "spatial_freq_cpd": 1.0, "pixels_per_degree": 50 }
  ]
}
