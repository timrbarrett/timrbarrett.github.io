          },
          {
            "type": "SendStringOverNUS",
            "value": "'(INSTRUCTION:_Test_complete!_Check_log_for_bias_analysis)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Mark Orientation FAIL",
        "label": "✗ FAIL",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(ORIENTATION_MEASUREMENT_FAILED)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(CHECK:_readings_outside_tolerance,_surface_not_level,_or_device_movement)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(INSTRUCTION:_Re-check_position_and_try_again)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "End Test 1.1 Auto",
        "label": "End T1.1 Auto",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(end_test_1.1_AUTO_TEST)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'daux)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'dauy)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'dauz)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(TEST_1.1_TERMINATED_BY_USER)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Store 50 Acc Readings",
        "label": "Store 50 Acc",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "(store-readings 50 'acc)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Hide Test 1.1 Auto Buttons",
        "label": "Hide T1.1 Auto",
        "actions": [
          {
            "type": "HideButton",
            "name": "Create Test 1.1 Self-Test Buttons"
          },
          {
            "type": "HideButton",
            "name": "Start Test 1.1 Auto"
          },
          {
