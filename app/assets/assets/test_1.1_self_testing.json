[
{
  "name": "Create Test 1.1 Self-Test Buttons",
  "label": "Setup T1.1 Self-Test",
  "actions": [
    {
      "type": "CreateButton",
      "button": {
        "name": "Start Test 1.1 Auto",
        "label": "Start T1.1 Auto",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(test_1.1:_raw-accelerometry_AUTO_START)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 500
          },
          {
            "type": "SendStringOverNUS",
            "value": "(emo dmrd 500)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "(ecr dmrd)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 200
          },
          {
            "type": "SendStringOverNUS",
            "value": "(emo dbsm 0)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "(ecr dbsm)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 200
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'daux)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 100
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'dauy)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 100
          },
          {
            "type": "SendStringOverNUS",
            "value": "(toggle 'dauz)\n"
          },
          {
            "type": "Wait",
            "milliseconds": 200
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(INSTRUCTION:_Place_device_ORANGE_face_up,_hold_steady_for_5_seconds)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Check Orange Up (+Z)",
        "label": "Check +Z",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(CHECKING_ORANGE_UP_+Z_ORIENTATION)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(EXPECTED:_daux≈0,_dauy≈0,_dauz≈+1)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(HOLD_STEADY_FOR_5_SECONDS...)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(orange_up_measurement_start)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Orange OK → Yellow",
        "label": "✓+Z → -Z",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(orange_up_measurement_complete_PASS)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(INSTRUCTION:_Flip_to_YELLOW_face_up,_hold_steady_for_5_seconds)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Check Yellow Up (-Z)",
        "label": "Check -Z",
        "actions": [
