          },
          {
            "type": "HideButton",
            "name": "Mark Orientation FAIL"
          },
          {
            "type": "HideButton",
            "name": "End Test 1.1 Auto"
          },
          {
            "type": "HideButton",
            "name": "Store 50 Acc Readings"
          },
          {
            "type": "CreateButton",
            "button": {
              "name": "Show Test 1.1 Auto Buttons",
              "label": "Show T1.1 Auto",
              "actions": [
                {
                  "type": "UnhideButton",
