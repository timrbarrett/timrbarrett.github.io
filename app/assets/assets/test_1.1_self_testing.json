          },
          {
            "type": "SendStringOverNUS",
            "value": "'(EXPECTED:_daux≈0,_dauy≈0,_dauz≈-1)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(HOLD_STEADY_FOR_5_SECONDS...)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(yellow_up_measurement_start)\n"
          }
        ]
      }
    },
    {
      "type": "CreateButton",
      "button": {
        "name": "Yellow OK → Green",
        "label": "✓-Z → +Y",
        "actions": [
          {
            "type": "SendStringOverNUS",
            "value": "'(yellow_up_measurement_complete_PASS)\n"
          },
          {
            "type": "SendStringOverNUS",
            "value": "'(INSTRUCTION:_Place_GREEN_face_up,_orange_face_east,_hold_steady)\n"
