[
  {
    "name": "Create Orientation Test",
    "label": "Setup Orientation Test",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "Initialize_Orientation_Test",
          "label": "Initialize Test",
          "colour": "#2196F3",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(orientation_test_initialized)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dpit)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'drol)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dyaw)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Orange_Up_Red_North",
          "label": "Orange Up, Red North",
          "colour": "#FFA000", 
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "GT", "left": "{{dpit}}", "right": -0.17 },
              { "operator": "LT", "left": "{{dpit}}", "right": 0.17 },
              { "operator": "GT", "left": "{{drol}}", "right": -0.17 },
              { "operator": "LT", "left": "{{drol}}", "right": 0.17 },
              { "operator": "GT", "left": "{{dyaw}}", "right": -0.17 },
              { "operator": "LT", "left": "{{dyaw}}", "right": 0.17 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(orange_up_red_north_achieved)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "Orange_Up_Red_North", 
              "colour": "#4CAF50"
            },
            {
              "type": "ChangeColour", 
              "name": "Orientation_Status", 
              "colour": "#4CAF50"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
