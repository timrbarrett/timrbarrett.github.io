  {
    "name": "Advanced_Orientation_Monitor",
    "label": "Advanced Monitor",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "Show_Orientation_Debug",
          "label": "Show Orientation Debug",
          "condition": {
            "operator": "GT",
            "left": 1,
            "right": 0
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(format \"Pitch: %f, Roll: %f, Yaw: %f\" dpit drol dyaw)\n"
            }
          ]
        }
      }
    ]
  }
