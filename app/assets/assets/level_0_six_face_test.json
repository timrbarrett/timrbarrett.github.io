[
  {
    "name": "Level_0_Setup",
    "label": "Level 0: Six Face Test Setup",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "Initialize_Level_0",
          "label": "Start Level 0 Test",
          "colour": "#2196F3",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Level 0: Six Face Orientation Test Started\\n\")\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test_started t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test_completed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar o_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar y_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar r_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar g_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar w_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar m_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"Place device with Orange face up\")\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(emo dmrd 500)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(ecr dmrd)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(emo dbsm 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(ecr dbsm)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgx)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgy)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgz)\n"
            },
            {
              "type": "ChangeColour",
              "name": "Initialize_Level_0",
              "colour": "#4CAF50"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Current_Instruction",
          "label": "{{current_instruction}}",
          "colour": "#8E24AA",
          "condition": {
            "operator": "EQUALS",
            "left": "{{test_started}}",
            "right": "t"
          }
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "O",
          "label": "O (+Z)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{o_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgz}}", "right": 0.85 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 1.15 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar o_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ Orange complete! Now place Yellow face up\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "O",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Orange face (+Z) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Y",
          "label": "Y (-Z)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{y_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgz}}", "right": -1.15 },
              { "operator": "LT", "left": "{{dcgz}}", "right": -0.85 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar y_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ Yellow complete! Now place Red face up\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "Y",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Yellow face (-Z) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "R",
          "label": "R (-Y)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{r_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -1.15 },
              { "operator": "LT", "left": "{{dcgy}}", "right": -0.85 },
              { "operator": "GT", "left": "{{dcgz}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 0.15 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar r_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ Red complete! Now place Green face up\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "R",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Red face (-Y) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "G",
          "label": "G (+Y)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{g_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgy}}", "right": 0.85 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 1.15 },
              { "operator": "GT", "left": "{{dcgz}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 0.15 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar g_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ Green complete! Now place White face up\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "G",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Green face (+Y) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "W",
          "label": "W (+X)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{w_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": 0.85 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 1.15 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgz}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 0.15 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar w_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ White complete! Now place Magenta face up\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "W",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"White face (+X) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "M",
          "label": "M (-X)",
          "colour": "#CCCCCC",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{m_up_passed}}", "right": "nil" },
              { "operator": "GT", "left": "{{dcgx}}", "right": -1.15 },
              { "operator": "LT", "left": "{{dcgx}}", "right": -0.85 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 0.15 },
              { "operator": "GT", "left": "{{dcgz}}", "right": -0.15 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 0.15 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar m_up_passed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"✓ All faces complete! Test finished successfully!\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "M",
              "colour": "#4CAF50"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Magenta face (-X) orientation detected and passed!\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Test_Complete_Checker",
          "label": "Check Test Completion",
          "colour": "#9C27B0",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{o_up_passed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{y_up_passed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{r_up_passed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{g_up_passed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{w_up_passed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{m_up_passed}}", "right": "t" }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test_completed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"(level_0_test_completed)\\n\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "Test_Complete_Checker",
              "colour": "#4CAF50"
            },
            {
              "type": "ChangeColour",
              "name": "Current_Instruction",
              "colour": "#4CAF50"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Progress_Display",
          "label": "Progress: {{o_up_passed}} {{y_up_passed}} {{r_up_passed}} {{g_up_passed}} {{w_up_passed}} {{m_up_passed}}",
          "colour": "#607D8B",
          "condition": {
            "operator": "EQUALS",
            "left": "{{test_started}}",
            "right": "t"
          }
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Reset_Level_0",
          "label": "Reset Test",
          "colour": "#F44336",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test_started nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test_completed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar o_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar y_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar r_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar g_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar w_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar m_up_passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar current_instruction \"Test reset. Click 'Start Level 0 Test' to begin\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "Initialize_Level_0",
              "colour": "#2196F3"
            },
            {
              "type": "ChangeColour",
              "name": "O",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "Y",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "R",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "G",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "W",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "M",
              "colour": "#CCCCCC"
            },
            {
              "type": "ChangeColour",
              "name": "Test_Complete_Checker",
              "colour": "#9C27B0"
            },
            {
              "type": "ChangeColour",
              "name": "Current_Instruction",
              "colour": "#8E24AA"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Level 0 test reset. Ready to start again.\\n\")\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Sensor_Values_Display",
          "label": "X:{{dcgx}} Y:{{dcgy}} Z:{{dcgz}}",
          "colour": "#455A64",
          "condition": {
            "operator": "EQUALS",
            "left": "{{test_started}}",
            "right": "t"
          }
        }
      }
    ]
  }
]
