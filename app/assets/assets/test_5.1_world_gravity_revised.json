      {
        "type": "CreateButton",
        "button": {
          "name": "Orange_Up",
          "label": "O Up",
          "colour": "#FFA500",
          "description": "Orange face up (Z+ up)",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "GT", "left": "{{dcgx}}", "right": -0.2 },
              { "operator": "LT", "left": "{{dcgx}}", "right": 0.2 },
              { "operator": "GT", "left": "{{dcgy}}", "right": -0.2 },
              { "operator": "LT", "left": "{{dcgy}}", "right": 0.2 },
              { "operator": "GT", "left": "{{dcgz}}", "right": 0.8 },
              { "operator": "LT", "left": "{{dcgz}}", "right": 1.2 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(orange_up)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar o_side 1)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"(orange_side_detected \")(princ o_side)(princ \")\\n\")\n"
            },
            {
              "type": "ChangeColour", 
              "name": "Orange_Up", 
              "colour": "#4CAF50"
            },
            {
              "type": "ChangeColour", 
              "name": "Test_Status", 
              "colour": "#4CAF50"
            }
          ]
        }
      },
