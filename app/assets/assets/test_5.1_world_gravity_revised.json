            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Test_Guide",
          "label": "First connect to LimbStim via BLE, then press 'T5.1 World Grav' button to begin",
          "colour": "#8E24AA",
          "condition": {
            "operator": "NOT",
            "expression": {
              "operator": "EQUALS", 
              "left": "{{test_started}}", 
              "right": "t"
            }
          },
          "actions": []
        }
      },
      {
        "type": "CreateButton", 
        "button": {
          "name": "Test_Guide_Progress",
          "label": "Place the device on each face and wait for buttons to turn green",
          "colour": "#8E24AA",
          "condition": {
            "operator": "AND",
            "expressions": [
              {
                "operator": "EQUALS", 
                "left": "{{test_started}}", 
                "right": "t"
              },
              {
                "operator": "NOT",
                "expression": {
                  "operator": "AND", 
                  "expressions": [
                    { "operator": "EQUALS", "left": "{{Orange_Up}}", "right": "#4CAF50" },
                    { "operator": "EQUALS", "left": "{{Yellow_Up}}", "right": "#4CAF50" },
                    { "operator": "EQUALS", "left": "{{Green_Up}}", "right": "#4CAF50" },
                    { "operator": "EQUALS", "left": "{{Red_Up}}", "right": "#4CAF50" },
                    { "operator": "EQUALS", "left": "{{White_Up}}", "right": "#4CAF50" },
                    { "operator": "EQUALS", "left": "{{Magenta_Up}}", "right": "#4CAF50" }
                  ]
                }
              },
              {
                "operator": "NOT",
                "expression": {
                  "operator": "EQUALS", 
                  "left": "{{test_completed}}", 
                  "right": "t"
                }
              }
            ]
          },
          "actions": []
        }
      },
      {
        "type": "CreateButton", 
        "button": {
          "name": "Test_Guide_Complete",
          "label": "Test Complete! Press 'End Test' to finish or 'Reset Test' to try again",
          "colour": "#4CAF50",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{test_completed}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{Orange_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Yellow_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Green_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Red_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{White_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Magenta_Up}}", "right": "#4CAF50" }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS", 
              "value": "(princ \"'(test_summary)\\n\")\n"
            },
            {
              "type": "SendStringOverNUS", 
              "value": "(princ \"(sides_detected \")(princ (+ o_side y_side g_side r_side w_side m_side))(princ \"/6)\\n\")\n"
            },
            {
              "type": "PressButton",
              "name": "Query_Test_Status"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Auto_End_Checker",
          "label": "Auto End Status",
          "colour": "#607D8B",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "EQUALS", "left": "{{test_started}}", "right": "t" },
              { "operator": "EQUALS", "left": "{{Orange_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Yellow_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Green_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Red_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{White_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{Magenta_Up}}", "right": "#4CAF50" },
              { "operator": "EQUALS", "left": "{{auto_end_enabled}}", "right": "t" },
              { "operator": "NOT", "expression": { "operator": "EQUALS", "left": "{{test_completed}}", "right": "t" }}
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(auto_ending_test)\n"
