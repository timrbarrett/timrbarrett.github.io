              "value": "(defvar test_completed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "'(end_of_test_5.1)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wcgx)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wcgy)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wcgz)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgx)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgy)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dcgz)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dpit)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'drol)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dyaw)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Auto_End_Toggle",
          "label": "Toggle Auto End",
          "colour": "#4CAF50",
          "condition": {
            "operator": "EQUALS",
            "left": "{{test_started}}",
            "right": "t"
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(defvar auto_end_enabled (not auto_end_enabled))\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"Auto-end is now \")\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(if auto_end_enabled (princ \"enabled\") (princ \"disabled\"))\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(princ \"\\n\")\n"
            },
            {
              "type": "ChangeColour",
              "name": "Auto_End_Toggle",
              "colour": "{{auto_end_enabled ? '#4CAF50' : '#607D8B'}}"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
