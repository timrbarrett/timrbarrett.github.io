              "type": "SendStringOverNUS",
              "value": "(let ((sides_sum (+ o_side y_side g_side r_side w_side m_side))) (princ \"'(test_ending_manually)\\n\") (if (= sides_sum 6) (princ \"'(test_5.1_completed_successfully)\\n\") (progn (princ \"'(test_5.1_incomplete_missing_sides)\\n\") (princ \"(sides_detected \")(princ sides_sum)(princ \"/6)\\n\"))))\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "'(end_of_test_5.1)\n"
