{
  "name": "velocity_test_button",
  "label": "Test Velocity Condition",
  "colour": "#FF5722",
  "condition": {
    "operator": "AND",
    "expressions": [
      { "operator": "GT", "left": "{{wvex}}", "right": 0.5 },
      { "operator": "LT", "left": "{{wvey}}", "right": 0.2 }
    ]
  },
  "actions": [
    {
      "type": "SendStringOverNUS",
      "value": "'(test_velocity_condition_met_wvex>0.5_wvey<0.2)\n"
    },
    {
      "type": "ChangeColour", 
      "name": "velocity_status_indicator", 
      "colour": "green"
    }
  ]
}
