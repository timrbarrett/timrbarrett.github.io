              "type": "SendStringOverNUS",
              "value": "'(orientation_test_initialized)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'dpit)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'drol)\n"
