mtllib cube.mtl

# Rotated Vertices (standing vertically on a 3x9 face)
v -4.5 -4.5 -1.5  # 1
v  4.5 -4.5 -1.5  # 2
v  4.5 -4.5  1.5  # 3
v -4.5 -4.5  1.5  # 4
v -4.5  4.5 -1.5  # 5
v  4.5  4.5 -1.5  # 6
v  4.5  4.5  1.5  # 7
v -4.5  4.5  1.5  # 8


# Texture coordinates (24 total, 4 per face)
vt 0.0    0.0   # 1
vt 0.333  0.0   # 2
vt 0.333  0.5   # 3
vt 0.0    0.5   # 4
vt 0.333  0.0   # 5
vt 0.666  0.0   # 6
vt 0.666  0.5   # 7
vt 0.333  0.5   # 8
vt 0.666  0.0   # 9
vt 1.0    0.0   # 10
vt 1.0    0.5   # 11
vt 0.666  0.5   # 12
vt 0.0    0.5   # 13
vt 0.333  0.5   # 14
vt 0.333  1.0   # 15
vt 0.0    1.0   # 16
vt 0.333  0.5   # 17
vt 0.666  0.5   # 18
vt 0.666  1.0   # 19
vt 0.333  1.0   # 20
vt 0.666  0.5   # 21
vt 1.0    0.5   # 22
vt 1.0    1.0   # 23
vt 0.666  1.0   # 24

# --- Faces (counterclockwise winding) ---
# Bottom face (Yellow, -Y)
usemtl Textured
f 5/4 6/3 2/2
f 2/2 1/1 5/4

# Top face (Orange, +Y)
usemtl Textured
f 3/6 7/7 8/8
f 8/8 4/5 3/6

# Left face (Green, -X)
usemtl Textured
f 1/10 4/11 8/12
f 8/12 5/9 1/10

# Right face (Red, +X) ✅ already correct
usemtl Textured
f 6/14 7/15 3/16
f 3/16 2/13 6/14

# Front face (Grey, +Z)
usemtl Textured
f 2/20 3/19 4/18
f 4/18 1/17 2/20

# Back face (Magenta, -Z)
usemtl Textured
f 6/22 5/21 8/24
f 8/24 7/23 6/22