  {
    "name": "Create Test Conditions",
    "label": "Setup Test Conditions",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "wvex_threshold",
          "label": "Velocity Status",
          "colour": "#FFA000"
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "x_axis_velocity_threshold",
          "label": "X-Velocity Test",
          "colour": "#2196F3",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "GT", "left": "{{wvex}}", "right": 0.45 },
              { "operator": "LT", "left": "{{wvex}}", "right": 0.55 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_x_velocity_threshold_reached)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "wvex_threshold", 
              "colour": "green"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "y_axis_velocity_threshold",
          "label": "Y-Velocity Test",
          "colour": "#4CAF50",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "GT", "left": "{{wvey}}", "right": 0.45 },
              { "operator": "LT", "left": "{{wvey}}", "right": 0.55 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_y_velocity_threshold_reached)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "wvex_threshold", 
              "colour": "blue"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "z_axis_velocity_threshold",
          "label": "Z-Velocity Test",
          "colour": "#9C27B0",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "GT", "left": "{{wvez}}", "right": 0.45 },
              { "operator": "LT", "left": "{{wvez}}", "right": 0.55 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_z_velocity_threshold_reached)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "wvex_threshold", 
              "colour": "purple"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "drift_detector",
          "label": "Drift Monitor",
          "colour": "#FF5722",
          "condition": {
            "operator": "OR",
            "expressions": [
              {
                "operator": "GT", 
                "left": "{{wvex}}", 
                "right": 0.05
              },
              {
                "operator": "GT", 
                "left": "{{wvey}}", 
                "right": 0.05
              },
              {
                "operator": "GT", 
                "left": "{{wvez}}", 
                "right": 0.05
              }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(drift_detected_exceeds_threshold)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "wvex_threshold", 
              "colour": "red"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "stationary_detector",
          "label": "Stationary Test",
          "colour": "#607D8B",
          "condition": {
            "operator": "AND",
            "expressions": [
              { "operator": "LT", "left": "{{wvex}}", "right": 0.02 },
              { "operator": "LT", "left": "{{wvey}}", "right": 0.02 },
              { "operator": "LT", "left": "{{wvez}}", "right": 0.02 },
              { "operator": "GT", "left": "{{ddce}}", "right": 0 }
            ]
          },
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(stationary_detection_working)\n"
            },
            {
              "type": "ChangeColour", 
              "name": "wvex_threshold", 
              "colour": "#00BCD4"
            }
          ]
        }
      }
    ]
  }
