      {
        "type": "CreateButton",
        "button": {
          "name": "Initialize Test 7.0 Orange",
          "label": "Init T7.0 System",
          "color": "#FF8C00",
          "textColor": "#FFFFFF",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_7.0:_initialize-orange-test)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-red-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-green-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-white-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-magenta-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-7.0-attempts 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-7.0-completed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(emo dmrd 255)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(ecr dmrd)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(eou dmrd 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wacx)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wacy)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(toggle 'wacz)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(dmrd 255 165 0)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "End Test 7.0 Orange",
          "label": "End T7.0 Test",
          "color": "#FF4500",
          "textColor": "#FFFFFF",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_7.0:_end-orange-test)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-7.0-completed t)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(incf test-7.0-attempts)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(if (and test-red-passed test-green-passed test-white-passed test-magenta-passed) (dmrd 0 255 0) (dmrd 255 0 0))\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(format t \"Test 7.0 Orange Results: Red=%s Green=%s White=%s Magenta=%s Attempts=%d\" test-red-passed test-green-passed test-white-passed test-magenta-passed test-7.0-attempts)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Reset Test 7.0 Orange",
          "label": "Reset T7.0",
          "color": "#8B4513",
          "textColor": "#FFFFFF",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_7.0:_reset-orange-test)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-red-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-green-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-white-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-magenta-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-7.0-attempts 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(setq test-7.0-completed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(dmrd 255 165 0)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Test 7.0 Status Check",
          "label": "T7.0 Status",
          "color": "#4169E1",
          "textColor": "#FFFFFF",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_7.0:_status-check)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(format t \"Test 7.0 Status: Red=%s Green=%s White=%s Magenta=%s\" test-red-passed test-green-passed test-white-passed test-magenta-passed)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(format t \"Accelerometer: X=%.3f Y=%.3f Z=%.3f\" ax ay az)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(format t \"Attempts: %d Completed: %s\" test-7.0-attempts test-7.0-completed)\n"
            }
          ]
        }
