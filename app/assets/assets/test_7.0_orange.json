[
  {
    "name": "Setup Test 7.0 Orange",
    "label": "Setup T7.0 Orange",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "Test 7.0: Red Face Accelerometry",
          "label": "T7.0 Red Face",
          "color": "#808080",
          "textColor": "#FFFFFF",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "'(test_7.0:_red-face-accel)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(defvar test-red-passed nil)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(if (and (> ax 0.8) (< (abs ay) 0.3) (< (abs az) 0.3)) (progn (setq test-red-passed t) (dmrd 255 0 0)) (dmrd 128 128 128))\n"
            },
            {
              "type": "ChangeButtonColor",
              "color": "#00FF00",
              "condition": "test-red-passed"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Test 7.0: Green Face Accelerometry",
