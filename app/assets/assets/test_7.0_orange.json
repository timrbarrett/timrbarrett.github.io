            {
              "type": "SendStringOverNUS",
              "value": "(if (and (< ax -0.8) (< (abs ay) 0.3) (< (abs az) 0.3)) (progn (setq test-green-passed t) (dmrd 0 255 0)) (dmrd 128 128 128))\n"
            },
            {
              "type": "ChangeButtonColor",
              "color": "#00FF00",
              "condition": "test-green-passed"
