              "value": "(emo dmrd 100)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(ecr dmrd)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(eou dmrd 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(emo dbsm 0)\n"
            },
            {
              "type": "SendStringOverNUS",
              "value": "(ecr dbsm)\n"
            },
            {
              "type": "SendStringOverNUS",
