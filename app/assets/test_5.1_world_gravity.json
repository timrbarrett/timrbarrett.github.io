  {
    "name": "Advanced_Monitor",
    "label": "Advanced Monitor",
    "actions": [
      {
        "type": "CreateButton",
        "button": {
          "name": "Detailed_Vector_Values",
          "label": "Detailed Vector Values",
          "colour": "#2196F3",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(format \"Device Gravity: X=%0.4f, Y=%0.4f, Z=%0.4f\\nWorld Gravity: X=%0.4f, Y=%0.4f, Z=%0.4f\" dcgx dcgy dcgz wcgx wcgy wcgz)\n"
            }
          ]
        }
      },
      {
        "type": "CreateButton",
        "button": {
          "name": "Calculate_Magnitude",
          "label": "Calculate Magnitude",
          "colour": "#2196F3",
          "actions": [
            {
              "type": "SendStringOverNUS",
              "value": "(format \"DCG Magnitude: %0.4f, WCG Magnitude: %0.4f\" (sqrt (+ (* dcgx dcgx) (* dcgy dcgy) (* dcgz dcgz))) (sqrt (+ (* wcgx wcgx) (* wcgy wcgy) (* wcgz wcgz))))\n"
            }
          ]
        }
      }
